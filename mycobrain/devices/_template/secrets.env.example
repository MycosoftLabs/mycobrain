# Per-device env template. Copy to /etc/mycobrain/agent.env on the host.
# Real secrets live in Claude memory and 1Password — NEVER commit a populated copy.

MYCOBRAIN_ADAPTER=<jetson_orin|jetson_legacy|raspberry_pi|standalone>
MYCOBRAIN_DEVICE_NICKNAME=<nickname>
MYCOBRAIN_HOST_IP=192.168.0.XXX

MYCOBRAIN_SIDE_A_PORT=/dev/ttyTHS1
MYCOBRAIN_SIDE_B_PORT=/dev/ttyTHS2
MYCOBRAIN_SERIAL_BAUD=115200

MYCOBRAIN_HTTP_HOST=0.0.0.0
MYCOBRAIN_HTTP_PORT=8787
MYCOBRAIN_AUTH_MODE=jwt
MYCOBRAIN_NATUREOS_JWKS_URL=https://mycosoft.com/.well-known/jwks.json

MYCOBRAIN_MQTT_URL=wss://mqtt.mycosoft.com
MYCOBRAIN_MQTT_USERNAME=mycobrain
MYCOBRAIN_MQTT_PASSWORD=<rotation-pending>

MYCOBRAIN_OPENCLAW_ENABLED=<true|false>
MYCOBRAIN_OPENCLAW_DAEMON_WS=ws://127.0.0.1:18789

# MycoBrain Agent — Jetson Orin (Mushroom 1 / Hyphae 1)
# Copy to /etc/mycobrain/agent.env and edit. See docs/PORT_8787_HTTP_API_SPEC_MAY19_2026.md.

MYCOBRAIN_ADAPTER=jetson_orin
MYCOBRAIN_DEVICE_NICKNAME=mushroom1
MYCOBRAIN_HOST_IP=192.168.0.228

# Serial — see /etc/nv_tegra_release for board
MYCOBRAIN_SIDE_A_PORT=/dev/ttyTHS1
MYCOBRAIN_SIDE_B_PORT=/dev/ttyTHS2
MYCOBRAIN_SERIAL_BAUD=115200

# HTTP (canonical port)
MYCOBRAIN_HTTP_HOST=0.0.0.0
MYCOBRAIN_HTTP_PORT=8787
MYCOBRAIN_PUBLIC_READS=true
MYCOBRAIN_AUTH_MODE=jwt
MYCOBRAIN_NATUREOS_JWKS_URL=https://mycosoft.com/.well-known/jwks.json

# MQTT (Cloudflare WSS in prod)
MYCOBRAIN_MQTT_URL=wss://mqtt.mycosoft.com
MYCOBRAIN_MQTT_USERNAME=mycobrain
MYCOBRAIN_MQTT_PASSWORD=CHANGE_ME

# OpenClaw
MYCOBRAIN_OPENCLAW_ENABLED=true
MYCOBRAIN_OPENCLAW_BASE_URL=http://127.0.0.1:8000
MYCOBRAIN_OPENCLAW_API_KEY=CHANGE_ME
MYCOBRAIN_OPENCLAW_TIMEOUT_MS=5000
MYCOBRAIN_OPENCLAW_AUDIT_PATH=/var/log/mycobrain/openclaw_audit.jsonl

# Upstream
MYCOBRAIN_MAS_HEARTBEAT_URL=https://mycosoft.com/api/devices/heartbeat
MYCOBRAIN_MINDEX_TELEMETRY_URL=https://mindex.mycosoft.com/api/fci/telemetry

# Observability
MYCOBRAIN_LOG_LEVEL=INFO
MYCOBRAIN_AUDIT_PATH=/var/log/mycobrain/agent_audit.jsonl

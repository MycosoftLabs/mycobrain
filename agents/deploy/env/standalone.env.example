# MycoBrain Agent — Standalone PC over USB-CDC
# For device #4 (bench MycoBrain plugged into a developer's machine).
# Works on Linux, macOS, Windows.

MYCOBRAIN_ADAPTER=standalone
MYCOBRAIN_DEVICE_NICKNAME=bench
# MYCOBRAIN_HOST_IP=...

# Windows: COM7 (use Get-PnpDevice to enumerate). Linux: /dev/ttyACM0 or /dev/ttyUSB0
MYCOBRAIN_SIDE_A_PORT=COM7
MYCOBRAIN_SERIAL_BAUD=115200

MYCOBRAIN_HTTP_HOST=0.0.0.0
MYCOBRAIN_HTTP_PORT=8787
MYCOBRAIN_PUBLIC_READS=true
MYCOBRAIN_AUTH_MODE=pair_token
MYCOBRAIN_PAIR_TOKEN=CHANGE_ME

MYCOBRAIN_MQTT_URL=wss://mqtt.mycosoft.com
MYCOBRAIN_MQTT_USERNAME=mycobrain
MYCOBRAIN_MQTT_PASSWORD=CHANGE_ME

# Standalone bench typically has no OpenClaw
MYCOBRAIN_OPENCLAW_ENABLED=false

MYCOBRAIN_LOG_LEVEL=INFO
